<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_modern_gradient">

    <!-- Список слів: розміщений найнижче в ієрархії, щоб під час скролінгу
         слова "заїжджали" під скляну панель і розмивалися під нею -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvDictionary"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingTop="110dp"
        android:paddingBottom="88dp" />

    <!-- Плашка порожнього словника у стилі Frosted Glass -->
    <LinearLayout
        android:id="@+id/emptyDictionaryLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="32dp"
        android:background="@drawable/bg_glass_panel"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone"
        tools:targetApi="s">

        <ImageView
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:alpha="0.8"
            android:src="@drawable/ic_dictionary"
            app:tint="?android:attr/textColorSecondary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="@font/montserrat_bold"
            android:text="@string/dictionary_empty"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="20sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/dict_empty_desc"
            android:textAlignment="center"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Верхня панель (Glassmorphism). Оскільки вона внизу XML-файлу,
         вона малюється поверх RecyclerView -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="24dp"
        android:background="@drawable/bg_glass_panel"
        android:paddingHorizontal="24dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        tools:targetApi="s">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/montserrat_bold"
            android:text="@string/dictionary"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="32sp"
            android:textStyle="bold" />
    </RelativeLayout>

</FrameLayout>